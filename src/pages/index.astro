---
import BaseLayout from "../layouts/BaseLayout.astro"
import IconContainer from "../components/IconContainer.astro"
import { Content as BioContent} from '../content/bio.md'
import { Icon } from 'astro-icon/components'
import Header from "../components/Header.astro";
import Prose from "../components/Prose.astro";
---

<BaseLayout title="Magnus Sørensen">
	<Header />
	<div class="hero">
		<div class="bio">
			<Prose>
				<BioContent />
			</Prose>
			<div id="contact-info">
				<IconContainer>
					<a href="https://github.com/MaVirgil" target="_blank">
						<Icon name="github" />
					</a>
					<a href="https://www.linkedin.com/in/magnus-virgil-s%C3%B8rensen-0167872b5/" target="_blank">
						<Icon name="linkedin" />
					</a>
					<a href="https://bsky.app/profile/mavirgil.com" target="_blank">
						<Icon name="bluesky" />
					</a>
				</IconContainer>
				<a href="mailto:Magnus@mavirgil.com">Magnus@mavirgil.com</a>
			</div>
		</div>
		<div class="illustration">
			<Icon name="profile"/>
		</div>
	</div>
</BaseLayout>

<style>

	.hero {
		margin-top: var(--gap-medium);
		display: flex;
		justify-content: space-evenly;
	}

	@Media (max-width: 650px) {
		.hero {
			flex-direction: column;
			flex-flow: column-reverse;
			text-align: center;
			align-items: center;
		}
	}

	.illustration [data-icon="profile"] {
		font-size: 10em;
		color: var(--text);
	}

	:root.light .illustration [data-icon="profile"] {
		color: antiquewhite;
	}

	.bio {
		max-width: 15em;
	}

	img {
		width: 8em;
		height: auto;
		fill: var(--text);
	}

	#contact-info {
		margin-top: var(--gap-tiny);
		text-align: center;
		display: inline-flex;
		flex-direction: column;
		gap: var(--gap-tiny);
	}

	#contact-info [data-icon] {
		font-size: 1.5em;
	}

	#contact-info [data-icon]:hover {
		color: var(--primary);
		transform: scale(1.1);
	}
</style>