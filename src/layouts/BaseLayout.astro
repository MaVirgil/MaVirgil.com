---
import Header from "../components/Header.astro";
const { title="default title" } = Astro.props;
const { maxWidth="33em"} = Astro.props;
import ThemeSwitcher from "../components/ThemeSwitcher.astro"
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="description" content="Computer Science student from Copenhagen, Denmark"/>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline>
        const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
            }

            return 'dark';
        })();

        if (theme === 'light') {
            document.documentElement.classList.add('light');
        } else {
            document.documentElement.classList.remove('light');
        }
    </script>
</head>
<body>
    <ThemeSwitcher />
<main>
    <slot />
</main>
</body>
</html>

<style is:global define:vars={{maxWidth}}>

    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap');

    /* dark-mode colors */
    :root {
        --bg: oklch(0.19 0.005 71);
        --bg-element: oklch(0.25 0.005 71);
        --text: oklch(0.96 0.07 69);
        --text-muted: oklch(0.76 0.07 69);
        --primary: oklch(0.681 0.1586 47.54);
        --secondary: oklch(0.70 0.07 250);
        --danger: oklch(0.36 0.1 30);
        --rounding: 18px;
        --edge-padding: 2em;
        --gap-tiny: 0.4em;
        --gap-small: 2em;
        --gap-medium: 4em;
        --gap-large: 6em;
        .astro-code,
        .astro-code span {
            color: var(--shiki-dark);
            background-color: var(--bg-element);
            font-style: var(--shiki-dark-font-style);
            font-weight: var(--shiki-dark-font-weight);
            text-decoration: var(--shiki-dark-text-decoration);
        }
    }

    .astro-code {
        padding: 1.2em;
        border-radius: var(--rounding);
    }

    /* light-mode colors */
    :root.light {
        --bg: oklch(.87 0.05 69);
        --bg-element: oklch(0.91 0.043 69);
        --text: oklch(0.15 0.0412 36.85);
        --text-muted: oklch(0.4 0.07 69);
        --primary: oklch(0.65 0.1586 47.54);
        --secondary: oklch(0.6 0.15 249);
        --danger: oklch(0.65 0.17 30);
        .astro-code,
        .astro-code span {
            color: var(--shiki-light);
            font-style: var(--shiki-light-font-style);
            font-weight: var(--shiki-light-font-weight);
            text-decoration: var(--shiki-light-text-decoration);
        }
    }

    html,
    body {
        scrollbar-gutter: stable both-edges;
        margin: 0;
        width: 100%;
        min-height: 100vh;
        background-color: var(--bg);
        color: var(--text);
        font-family: sans-serif;
        font-size: 18px;
    }

    main {
        margin: auto;
        padding: 0 var(--edge-padding) 6em;
        max-width: var(--maxWidth);
    }

    hr {
        border: 1px solid var(--primary);
        border-radius: 2px;
    }

    a {
        color: var(--text);
        text-decoration-color: var(--primary);
        text-decoration-thickness: 2px;
        text-decoration-skip-ink: none;
        text-underline-offset: 0.3em;
        cursor: pointer;
    }

    a:hover {
        color: var(--primary);
    }

    li::marker {
        color: var(--primary);
    }

    ::selection {
        background-color: var(--primary);
    }
</style>
